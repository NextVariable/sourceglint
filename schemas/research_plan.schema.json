{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gtm-intelligence.dev/research_plan.schema.json",
  "title": "Research Plan",
  "description": "Structured description of ONE research task, produced by the Research Planner BEFORE any search happens (PRD §4). Modes: general | trend | competitor | market | voc | launch | channel. Time window supports relative (days) and custom (start/end) forms.",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "mode", "time_window"],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "What the research is about (PRD §4)."
    },
    "entities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Named entities (products/companies/people). Optional for  open market scans."
    },
    "market": {
      "$ref": "https://schemas.gtm-intelligence.dev/common.schema.json#/$defs/market_code",
      "description": "Target market. Absent = global."
    },
    "locale": {
      "$ref": "https://schemas.gtm-intelligence.dev/common.schema.json#/$defs/locale_code"
    },
    "languages": {
      "type": "array",
      "items": { "$ref": "https://schemas.gtm-intelligence.dev/common.schema.json#/$defs/language_code" },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Languages to research in. Never assume English covers a  local market (PRD §5)."
    },
    "time_window": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["days"],
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "description": "Relative window: last N days (7/14/30/90)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "https://schemas.gtm-intelligence.dev/common.schema.json#/$defs/iso_timestamp" },
            "end": { "$ref": "https://schemas.gtm-intelligence.dev/common.schema.json#/$defs/iso_timestamp" }
          },
          "description": "Custom window. start <= end is a VALIDATOR concern  (Phase 2), not a schema concern."
        }
      ]
    },
    "decision_context": {
      "type": "string",
      "minLength": 1,
      "description": "Why this research runs + what decision it feeds (PRD §4).  Drives Decision Relevance scoring."
    },
    "mode": {
      "type": "string",
      "enum": ["general", "trend", "competitor", "market", "voc", "launch", "channel"]
    },
    "required_evidence_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["T1_official", "T2_community", "T3_marketplace", "T4_secondary"]
      },
      "uniqueItems": true,
      "description": "Evidence tiers the answer must lean on (v0.2 §8.1)."
    },
    "queries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Expanded queries. May be empty before expansion runs."
    },
    "source_priorities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Ordered source names from sources.yaml. Absent = registry default order."
    }
  }
}
